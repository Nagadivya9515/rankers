# Force devDependencies to always be installed for this project, regardless
# of the shell's NODE_ENV. Without this, `npm install`/`npm ci` run from a
# shell with NODE_ENV=production (e.g. some conda "base" environment setups)
# silently skips devDependencies — including tailwindcss/postcss/autoprefixer,
# which breaks the CSS build and crashes the app on load.
include=dev
